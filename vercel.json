{
  "version": 2,
  "buildCommand": "pnpm --filter cavi-frontend build",
  "devCommand": "pnpm --filter cavi-frontend dev",
  "installCommand": "pnpm install",
  "framework": "nextjs",
  "outputDirectory": "frontend/.next",
  "env": {
    "NEXT_PUBLIC_VERCEL_URL": "${VERCEL_URL}"
  },
  "github": {
    "silent": true,
    "autoAlias": true
  }
}
