# ==============================================================================
# CAVI Frontend Environment Configuration (Vercel / Client)
# ==============================================================================

# Backend API Base URL (Point to Render backend URL in production)
# Example: NEXT_PUBLIC_API_URL=https://cavi-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:4000

# Agora RTC & Conversational AI Credentials (Client-Safe)
NEXT_PUBLIC_AGORA_APP_ID=your_agora_app_id
NEXT_PUBLIC_AGORA_AGENT_ID=your_agent_preset_id

# Direct Client Keys (Optional - fallback only if backend unavailable)
NEXT_PUBLIC_OPENROUTER_API_KEY=
NEXT_PUBLIC_GEMINI_API_KEY=
NEXT_PUBLIC_DEEPGRAM_API_KEY=
NEXT_PUBLIC_ELEVENLABS_API_KEY=
