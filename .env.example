# ==============================================================================
# CAVI (Customer Assistance through Voice Intelligence) Environment Variables
# ==============================================================================

# Agora RTC & Conversational AI Credentials
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate
AGORA_CONVERSATIONAL_AI_API_KEY=your_conversational_ai_api_key

# Agora Conversational AI Agent Graph / Preset ID
NEXT_PUBLIC_AGORA_AGENT_ID=your_agent_preset_id

# MongoDB Connection URI
MONGODB_URI=mongodb://127.0.0.1:27017/echosphere

# App Base URL (For Webhook and Telephony callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000
