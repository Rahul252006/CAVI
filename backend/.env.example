# ==============================================================================
# CAVI Backend Environment Configuration (Render / Server)
# ==============================================================================

# Server Port & Environment
PORT=4000
NODE_ENV=production
CORS_ORIGIN=*

# MongoDB Connection URI (e.g. MongoDB Atlas)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/echosphere?retryWrites=true&w=majority

# Agora RTC & Conversational AI Credentials
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate
AGORA_CONVERSATIONAL_AI_API_KEY=your_conversational_ai_api_key
AGORA_AGENT_ID=your_agent_preset_id

# Voice & Speech Synthesis
ELEVENLABS_API_KEY=your_elevenlabs_api_key
DEEPGRAM_API_KEY=your_deepgram_api_key

# LLM Providers (OpenRouter / Gemini)
OPENROUTER_API_KEY=your_openrouter_api_key
GEMINI_API_KEY=your_gemini_api_key

# Authentication
JWT_SECRET=your_secure_jwt_secret_key
