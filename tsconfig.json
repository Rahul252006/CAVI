{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "strict": true
  },
  "include": [
    "scripts/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    ".next",
    "**/.next",
    "backend/dist"
  ],
  "references": [
    { "path": "./frontend" },
    { "path": "./backend" }
  ]
}
